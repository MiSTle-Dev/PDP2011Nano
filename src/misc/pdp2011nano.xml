<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal configuration -->
<config name="PDP2011Nano" version="0">
  <actions>
    <!-- the init action is being executed immediately -->
    <!-- when this file has been loaded -->
    <action name="init">
      <!-- (try to) load config from sd card -->
      <load file="pdp2011nano.ini"/>
      <set id="R" value="3"/>  <!-- keep machine in cold reset -->
    </action>
    
    <!-- the ready action is being executed once all -->
    <!-- initialization has been done -->
    <action name="ready">
      <set id="R" value="0"/>  <!-- release reset -->
    </action>
      
    <action name="save">
      <!-- save config to sd card -->
      <save file="pdp2011nano.ini"/>
    </action>
      
    <action name="reset">
      <!-- trigger a system reset -->
      <set id="R" value="1"/>
      <delay ms="10"/>
      <set id="R" value="0"/>      
    </action>
    
    <action name="reset_hide">
      <!-- trigger a system reset and hide OSD -->
      <link action="reset"/>
      <hide/>      
    </action>      

    <action name="cold_reset">
      <!-- trigger a cold system reset -->
      <set id="R" value="3"/>
      <delay ms="10"/>
      <set id="R" value="0"/>      
    </action>
    
    <action name="cold_reset_hide">
      <!-- trigger a cold reset and hide OSD -->
      <link action="cold_reset"/>
      <hide/>      
    </action>
  </actions>
  
  <menu label="PDP2011Nano">
    <menu label="System">
      <list label="PDP-11 Model" id="M" default="0">
	<listentry label="20" value="0"/>
	<listentry label="34" value="1"/>
	<listentry label="44" value="2"/>
	<listentry label="45" value="3"/>
	<listentry label="70" value="4"/>
	<listentry label="94" value="5"/>
      </list>
      <list label="Terminal type:" id="D" default="0">
	<listentry label="VT100" value="0"/>
	<listentry label="VT105" value="1"/>
      </list>
      <list label="Cursor type:" id="N" default="0">
	<listentry label="Underline" value="0"/>
	<listentry label="Block" value="1"/>
      </list>
      <list label="Cursor blink:" id="I" default="0">
	<listentry label="Off" value="0"/>
	<listentry label="On" value="1"/>
      </list>
      <list label="Color:" id="(" default="0">
	<listentry label="Green" value="0"/>
	<listentry label="Blue" value="1"/>
	<listentry label="White" value="2"/>
	<listentry label="Amber" value="3"/>  
      </list>
      <list label="Console:" id="O" default="0">
	<listentry label="Virtual VT1" value="0"/>
	<listentry label="Serial 19200 baud" value="1"/>
      </list>
    <button label="Reset" action="reset_hide"/>
    </menu>
    <menu label="Storage">
      <fileselector label="Mount RK:" ext="dsk" index="0"/>
      <fileselector label="Mount RL:" ext="dsk" index="1"/>
      <fileselector label="Mount RH: RM/RP" ext="dsk" index="2"/>
	<!--IS mistle_gw5a_25 tang_primer25k tang_console60k tang_console138k tang_mega138kpro tang_mega60k -->
      <fileselector label="Mount TU:" ext="tap" index="3"/>
	<!--END-->
      <list label="RH Type:" id=")" default="6">
	<listentry label="RM06" value="1"/>
	<listentry label="RP2G" value="2"/>
	<listentry label="-" value="3"/>
	<listentry label="RP04/RP05" value="4"/>
	<listentry label="RM05" value="5"/>
	<listentry label="RP06" value="6"/>
	<listentry label="RP07" value="7"/>
      </list>
    <button label="Reset" action="reset_hide"/>
    </menu>
    <menu label="Settings">
      <list label="Screen:" id="W" default="0">
	<listentry label="Normal" value="0"/>
	<listentry label="Wide" value="1"/>
      </list>
      <list label="Scanlines:" id="S" default="0">
	<listentry label="None" value="0"/>
	<listentry label="25%" value="1"/>
	<listentry label="50%" value="2"/>
	<listentry label="75%" value="3"/>
      </list>
      <list label="Volume:" id="A" default="2">
	<listentry label="Mute" value="0"/>
	<listentry label="33%" value="1"/>
	<listentry label="66%" value="2"/>
	<listentry label="100%" value="3"/>
      </list>
      <button label="Save settings" action="save"/>
    </menu>
    <button label="Cold Reset" action="cold_reset_hide"/>
  </menu>
</config>
