       1                                         .title   M9312 boot roms
       2                                ;
       3                                ;
       4                                ; boot code taken from http://ak6dn.dyndns.org/PDP-11/M9312/ and modified to work with m9312l47.mac
       5                                ; which does not include diagnostics, does not use the rom code letters.
       6                                ;
       7                                ; $Revision$
       8                                
       9 000001                         bit0     =000001              ; plain old bit definitions
      10 000002                         bit1     =000002              ;
      11 000004                         bit2     =000004              ;
      12 000010                         bit3     =000010              ;
      13 000020                         bit4     =000020              ;
      14 000040                         bit5     =000040              ;
      15 000100                         bit6     =000100              ;
      16 000200                         bit7     =000200              ;
      17 000400                         bit8     =000400              ;
      18 001000                         bit9     =001000              ;
      19 002000                         bit10    =002000              ;
      20 004000                         bit11    =004000              ;
      21 010000                         bit12    =010000              ;
      22 020000                         bit13    =020000              ;
      23 040000                         bit14    =040000              ;
      24 100000                         bit15    =100000              ;
      25                                
      26 000040                         BL       =040                 ; ascii SPACE
      27 000015                         CR       =015                 ; ascii CR
      28 000012                         LF       =012                 ; ascii LF
      29 000400                         U        =bit8                ; upperbyte multiplier
      30 000001                         L        =bit0                ; lowerbyte multiplier
      31                                
      32                                         .asect
      33 173000                                  .=173000
      34                                ;
      35                                ; entry points: 173000 is the reset start address
      36                                ;
      37 173000 000137  173014                   jmp   @#boot         ; 173000
      38 173004 000137  173676                   jmp   @#prtoct       ; 173004
      39                                bprtascz:
      40 173010 000137  173652                   jmp   @#prtascz      ; 173010
      41                                ;
      42                                ; boot: try rk, rl, rp, tc in bootdev order and boot from the first that exists
      43                                ; r4 - pointer to current bootdev entry (csr, boot message, go routine)
      44                                ; a missing controller times out through vector 4 to fail, which moves to the next entry
      45                                ;
      46 173014 012704  173116          boot:    mov   #bootdev,r4
      47 173020 012706  001000          try:     mov   #1000,sp
      48 173024 005037  000006                   clr   @#6
      49 173030 020427  173146                   cmp   r4,#bootend    ; all entries tried?
      50 173034 001005                           bne   1$
      51 173036 012702  173256                   mov   #nodev,r2
      52 173042 010701                           mov   pc,r1
      53 173044 000761                           br    bprtascz
      54 173046 000000                           halt
      55                                
      56 173050 012737  173110  000004  1$:      mov   #fail,@#4
      57 173056 011405                           mov   (r4),r5
      58 173060 005715                           tst   (r5)           ; probe csr, traps if absent
      59 173062 016402  000002                   mov   2(r4),r2
      60 173066 010701                           mov   pc,r1
      61 173070 000747                           br    bprtascz
      62 173072 005037  000004                   clr   @#4
      63 173076 005037  000006                   clr   @#6
      64 173102 005000                           clr   r0
      65 173104 000174  000004                   jmp   @4(r4)
      66                                
      67 173110 062704  000006          fail:    add   #6,r4
      68 173114 000741                           br    try
      69                                
      70                                         .even
      71 173116 177400  173146  173444  bootdev: .word rkcsr,bootrk,rkgo
      72 173124 174400  173170  173300           .word rlcsr,bootrl,rlgo
      73 173132 176700  173212  173554           .word rmcsr,bootrp,rpgo
      74 173140 177340  173234  173534           .word tccsr,boottc,tcgo
      75                                bootend:
      76                                
      77 173146    015     012          bootrk:  .ascii <15><12>
      78 173150    142     157     157           .ascii /boot from rk:/
         173153    164     040     146  
         173156    162     157     155  
         173161    040     162     153  
         173164    072                  
      79 173165    015     012     000           .asciz <15><12>
      80 173170    015     012          bootrl:  .ascii <15><12>
      81 173172    142     157     157           .ascii /boot from rl:/
         173175    164     040     146  
         173200    162     157     155  
         173203    040     162     154  
         173206    072                  
      82 173207    015     012     000           .asciz <15><12>
      83 173212    015     012          bootrp:  .ascii <15><12>
      84 173214    142     157     157           .ascii /boot from rp:/
         173217    164     040     146  
         173222    162     157     155  
         173225    040     162     160  
         173230    072                  
      85 173231    015     012     000           .asciz <15><12>
      86 173234    015     012          boottc:  .ascii <15><12>
      87 173236    142     157     157           .ascii /boot from tc:/
         173241    164     040     146  
         173244    162     157     155  
         173247    040     164     143  
         173252    072                  
      88 173253    015     012     000           .asciz <15><12>
      89 173256    015     012          nodev:   .ascii <15><12>
      90 173260    142     157     157           .ascii /boot: no dev/
         173263    164     072     040  
         173266    156     157     040  
         173271    144     145     166  
      91 173274    015     012     000           .asciz <15><12>
      92 173277    000                           .even
      93                                
      94                                ; --------------------------------------------------
      95                                ; rl
      96                                ; --------------------------------------------------
      97                                
      98 174400                         rlcsr     =174400             ; std RL11 csrbase
      99                                
     100 000000                         rlcs      =+0                 ; control/status
     101 000002                         rlba      =+2                 ; bus address
     102 000004                         rlda      =+4                 ; disk address
     103 000006                         rlmp      =+6                 ; multipurpose
     104                                
     105 000004                         cmstat    =2*2                ; get status
     106 000006                         cmseek    =3*2                ; seek
     107 000010                         cmrdhd    =4*2                ; read header
     108 000014                         cmrdda    =6*2                ; read data
     109                                
     110 173300 012701  174400          rlgo:    mov   #rlcsr,r1
     111 173304 010003                           mov   r0,r3          ; save unit number
     112 173306 000303                           swab  r3             ; unit number in upper byte
     113 173310 010311                           mov   r3,(r1)        ; set unit, NOP cmd
     114                                
     115 173312 012761  000013  000004           mov   #013,rlda(r1)  ; subcmd reset+getstatus
     116 173320 052703  000004                   bis   #cmstat,r3     ; get status cmd (r3lo is 0)
     117 173324 010311                           mov   r3,(r1)        ; execute
     118 173326 105711                  1$:      tstb  (r1)           ; test for ready
     119 173330 100376                           bpl   1$             ; wait
     120                                
     121 173332 105003                           clrb  r3             ; unit number in upper byte
     122 173334 052703  000010                   bis   #cmrdhd,r3     ; read header cmd
     123 173340 010311                           mov   r3,(r1)        ; execute
     124 173342 105711                  2$:      tstb  (r1)           ; test for ready
     125 173344 100376                           bpl   2$             ; wait
     126                                
     127 173346 016102  000006                   mov   rlmp(r1),r2    ; retrieve cyl/head/sector
     128 173352 042702  000077                   bic   #77,r2         ; set sector to zero
     129 173356 005202                           inc   r2             ; set head 0, seek to cyl 0
     130 173360 010261  000004                   mov   r2,rlda(r1)    ; into da for seek
     131 173364 105003                           clrb  r3             ; unit number in upper byte
     132 173366 052703  000006                   bis   #cmseek,r3     ; seek cmd
     133 173372 010311                           mov   r3,(r1)        ; execute
     134 173374 105711                  3$:      tstb  (r1)           ; test for ready
     135 173376 100376                           bpl   3$             ; wait
     136                                
     137 173400 005061  000004                   clr   rlda(r1)       ; select cyl0/head0/sector0
     138 173404 012761  177000  000006           mov   #-512.,rlmp(r1)      ; set word count
     139 173412 105003                           clrb  r3             ; unit number in upper byte
     140 173414 052703  000014                   bis   #cmrdda,r3     ; read data cmd
     141 173420 010311                           mov   r3,(r1)        ; execute
     142 173422 105711                  4$:      tstb  (r1)           ; test for ready
     143 173424 100376                           bpl   4$             ; wait
     144                                
     145 173426 005711                           tst   (r1)           ; test for error
     146 173430 100002                           bpl   5$             ; br if ok
     147 173432 000005                           reset                ; ERROR - reset the world
     148 173434 000721                           br rlgo              ; retry
     149                                
     150 173436 042711  000377          5$:      bic   #377,(r1)      ; execute nop cmd
     151 173442 005007                           clr   pc             ; jump to bootstrap at zero
     152                                
     153                                ; --------------------------------------------------
     154                                ; rk
     155                                ; --------------------------------------------------
     156                                
     157 177400                         rkcsr    =177400              ; std RK03/05 DECdisk csrbase
     158                                
     159 000002                         rkwc     =+6-4                ; word count
     160 000004                         rkba     =+10-4               ; bus address
     161 000006                         rkda     =+12-4               ; disk address
     162                                
     163 177340                         tccsr    =177340              ; std TU55/56 DECtape csrbase
     164                                
     165 177776                         tccs     =+0-2                ; control/status
     166 000002                         tcwc     =+4-2                ; word count
     167                                
     168 000002                         xxwc     =rkwc                ; common word count offset
     169                                
     170 165564                         diags    =165564              ; console diags phase2 entry
     171                                
     172                                
     173 173444 012701  177404          rkgo:    mov   #rkcsr+4,r1    ; boot std csr, unit <R0>
     174 173450 005061  000004                   clr   rkba(r1)       ; clear bus address
     175 173454 010003                           mov   r0,r3          ; get unit number
     176 173456 000241                           clc                  ; C=0 for ror
     177 173460 006003                           ror   r3             ; shift into 15:12
     178 173462 006003                           ror   r3             ;
     179 173464 006003                           ror   r3             ;
     180 173466 006003                           ror   r3             ;
     181 173470 010361  000006                   mov   r3,rkda(r1)    ; unit number, sector 0 to disk addr
     182                                
     183 173474 012761  177000  000002  common:  mov   #-512.,xxwc(r1)   ; set word count
     184 173502 052703  000005                   bis   #5,r3          ; command READ+GO
     185 173506 010311                           mov   r3,(r1)        ; execute
     186 173510 105711                  2$:      tstb  (r1)           ; test ready
     187 173512 100376                           bpl   2$             ; loop
     188                                
     189 173514 005711                           tst   (r1)           ; check error
     190 173516 100003                           bpl   3$             ; br if no error
     191                                
     192 173520 000005                           reset                ; reset the world
     193 173522 000174  000004                   jmp   @4(r4)         ; and retry the current device
     194                                
     195 173526 042711  000377          3$:      bic   #377,(r1)      ; nop command
     196 173532 005007                           clr   pc             ; jump to loaded boot sector
     197                                
     198 173534 012701  177342          tcgo:    mov   #tccsr+2,r1    ; boot std csr, unit <R0>
     199 173540 010003                           mov   r0,r3          ; get unit number
     200 173542 000303                           swab  r3             ; unit number in upper byte
     201 173544 010311                           mov   r3,(r1)        ; set unit in controller
     202 173546 005061  000004                   clr   4(r1)          ; bus address 0
     203 173552 000750                           br    common
     204                                
     205                                
     206                                ; --------------------------------------------------
     207                                ; rp
     208                                ; --------------------------------------------------
     209                                
     210 176700                         rmcsr    =176700              ; std RH11 csrbase
     211                                
     212 000000                         rpcs  =+0                     ; control status offset
     213 000002                         rpwc  =+2                     ; word count offset
     214 000004                         rpba  =+4                     ; bus addr offset
     215 000010                         rpcs2 =+10                    ; control status 2 offset
     216 000016                         rpas  =+16                    ; atten summary offset
     217 000032                         rpof  =+32                    ; offset register offset
     218                                
     219                                
     220 173554 012701  176700          rpgo:    mov   #rmcsr,r1      ; boot std csr, unit <R0>
     221                                
     222 173560 010061  000010                   mov   r0,rpcs2(r1)   ; set unit number into controller
     223 173564 012702  000071                   mov   #071,r2        ; READ+GO command code
     224 173570 012711  000021                   mov   #021,(r1)      ; RIP+GO command
     225 173574 012761  014000  000032           mov   #014000,rpof(r1)  ; set 16b mode, inhibit ECC mode
     226 173602 016161  000016  000016           mov   rpas(r1),rpas(r1) ; clear attention bits
     227                                
     228 173610 012761  177000  000002           mov   #-512.,rpwc(r1)      ; set word count
     229 173616 011103                           mov   (r1),r3        ; get unit number
     230 173620 042703  000377                   bic   #377,r3        ; clear command byte
     231 173624 050203                           bis   r2,r3          ; insert read command code
     232 173626 010311                           mov   r3,(r1)        ; execute read command
     233 173630 105711                  2$:      tstb  (r1)           ; test unit ready
     234 173632 100376                           bpl   2$             ; br if not yet
     235                                
     236 173634 005711                           tst   (r1)           ; test any error
     237 173636 100002                           bpl   3$             ; br if not
     238                                
     239 173640 000005                           reset                ; error, reset the world
     240 173642 000744                           br rpgo              ; and jump back to restart
     241                                
     242 173644 042711  000377          3$:      bic   #377,(r1)      ; nop command, clear controller
     243 173650 005007                           clr   pc             ; jump to bootstrap start
     244                                
     245                                
     246                                ;
     247                                ; prtascz
     248                                ; r1 - return address
     249                                ; r2 - pointer to asciz string
     250                                ;
     251                                prtascz:
     252                                $10:
     253 173652 105737  177564                   tstb  @#177564
     254 173656 100375                           bpl   $10
     255 173660 105712                           tstb  (r2)
     256 173662 001403                           beq   $20
     257 173664 112237  177566                   movb  (r2)+,@#177566
     258 173670 000770                           br    $10
     259                                $20:
     260 173672 000161  000002                   jmp   2(r1)
     261                                ;
     262                                ; prtoct
     263                                ;
     264                                ; R0 = register value to print
     265                                ; R1 = return address
     266                                ; R2 = temp char
     267                                ; R3 = temp addr
     268                                
     269 173676 012702  000030          prtoct:  mov   #<'0/bit1>,r2  ; ascii 0 right 1b
     270 173702 000261                           sec                  ; shift a 1 into R0 lsb as done bit
     271 173704 006100                  1$:      rol   r0             ; msb out of R0
     272 173706 106102                           rolb  r2             ; into lsb of R2
     273 173710 010703                           mov   pc,r3          ; ret addr
     274 173712 105737  177564                   tstb  @#177564
     275 173716 100375                           bpl   .-4
     276 173720 110237  177566                   movb  r2,@#177566
     277 173724 012702  020206                   mov   #<BL*bit8>+200+<'0/bit3>,r2 ; ascii SP upper, ascii 0 right 3b lower
     278 173730 006300                  2$:      asl   r0             ; msb out of R0
     279 173732 001403                           beq   3$             ; when R0 has gone to zero we are done
     280 173734 106102                           rolb  r2             ; into lsb of R2
     281 173736 103774                           bcs   2$             ; loop once more if flagbit was set
     282 173740 000761                           br    1$             ; go get last bit and print char
     283                                3$:
     284 173742 000161  000002                   jmp   2(r1)          ; return
     285                                ;
     286                                ;
     287                                ;
     288                                   .end
